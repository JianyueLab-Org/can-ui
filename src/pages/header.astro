---
import ThemeScript from "../components/ThemeScript.astro";
import HeaderDemo from "../demo/HeaderDemo.vue";
import "../styles/index.css";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>站头与页脚 · can-ui</title>
    <meta
      name="description"
      content="SiteHeader 与 SiteFooter —— 四个页面站共用的站头、全网菜单与页脚。"
    />
    <ThemeScript />
  </head>
  <!-- No GalleryLayout: SiteHeader is the page's own header, and a header
       inside the gallery's header demonstrates nothing. -->
  <body class="bg-surface">
    <HeaderDemo client:load />
  </body>
</html>
