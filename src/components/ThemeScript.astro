---
/**
 * The no-flash theme script.
 *
 * Must be rendered in <head>, before any content. It runs synchronously and
 * sets `.dark` on <html> before the first paint — an async or deferred script
 * would let the page paint light and then snap to dark, which is a full-screen
 * brightness jump on every single navigation. That flash is the entire reason
 * this is inline and blocking rather than part of the bundle.
 *
 * It reads the same three-mode contract as `useTheme`: `light` and `dark` are
 * explicit choices, and **anything else — including no stored value at all —
 * means follow the system.** Storing "follow the system" as the absence of a
 * key is what makes returning to it a `removeItem` rather than a third string
 * that both this script and the composable would have to agree about.
 *
 * `color-scheme` is set in the same breath so the chrome the browser paints
 * itself — form controls, the canvas between navigations, scrollbar gutters —
 * swaps with the page rather than a frame later.
 */
---

<script is:inline>
  (() => {
    try {
      // The cookie is the source of truth: it is written on the parent domain
      // so the appearance follows a member across the network, which
      // localStorage — scoped to one origin — can never do. localStorage is
      // read as a fallback so an existing choice is not lost on the first
      // visit after this shipped.
      const m = document.cookie.match(/(?:^|;\s*)theme=([^;]*)/);
      const stored = m
        ? decodeURIComponent(m[1])
        : localStorage.getItem("theme");
      const dark =
        stored === "dark" ||
        (stored !== "light" &&
          matchMedia("(prefers-color-scheme: dark)").matches);
      document.documentElement.classList.toggle("dark", dark);
      document.documentElement.style.colorScheme = dark ? "dark" : "light";
    } catch {
      // Private mode can throw on localStorage. Light is the safe default —
      // never let a storage failure take the page down with it.
    }
  })();
</script>
