{
  "name": "can-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Cerulean Aviation Network design system — tokens, motion and Vue primitives shared by every CAN web component.",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.3"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles": "./src/styles/index.css",
    "./styles/*": "./src/styles/*",
    "./motion": "./src/motion/index.ts",
    "./composables": "./src/composables/index.ts",
    "./icons": "./src/icons.ts",
    "./components/*": "./src/components/*"
  },
  "scripts": {
    "dev": "astro dev --port 4327",
    "build": "astro build",
    "preview": "astro preview --port 4327",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check && node ./scripts/typecheck-vue.mjs",
    "typecheck:astro": "astro check",
    "typecheck:vue": "node ./scripts/typecheck-vue.mjs",
    "test": "bun test",
    "lint": "bun run format:check && bun run typecheck && bun test"
  },
  "peerDependencies": {
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.0",
    "@astrojs/vue": "^7.0.0",
    "astro": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.8"
  }
}
